#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <12>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        // 回路図 Polaris_L.kicad_sch の U1 ラベルより完全に一致するGPIOを抽出
        col-gpios
            = <&gpio0 2  GPIO_ACTIVE_HIGH> // Col0 (PA02_A0_D0)
            , <&gpio0 3  GPIO_ACTIVE_HIGH> // Col1 (PA03_A1_D1)
            , <&gpio0 28 GPIO_ACTIVE_HIGH> // Col2 (PA28_A2_D2) ※ココが修正点です
            , <&gpio0 4  GPIO_ACTIVE_HIGH> // Col3 (PA04_A4_D4_SDA)
            , <&gpio0 5  GPIO_ACTIVE_HIGH> // Col4 (PA05_A5_D5_SCL)
            , <&gpio1 11 GPIO_ACTIVE_HIGH> // Col5 (PB11_A6_D6_TX) ※ココが修正点です
            ;

        row-gpios
            = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row0 (PA10_A10_D10_MISO) ※ココが修正点です
            , <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row1 (PA09_A9_D9_MOSI)
            , <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row2 (PA08_A8_D8_SCK)
            , <&gpio1 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row3 (PB09_A7_D7_RX)
            ;
    };
};

&uicr {
    nfct-pins-as-gpios;
};