/*
 * Polaris Right (Polaris_R) 6x4 keyboard overlay
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <4>;
        map = <
            RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)
            RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
            RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)
            RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "row2col"; 

        col-gpios
            = <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Col0: D4 (PA8) */
            , <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Col1: D5 (PA9) */
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Col2: D6 (PB08) */
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Col3: D9 (PA6) */
            , <&gpio1 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Col4: D7 (PB09) */
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Col5: NFC2 (P0.10) */
            ;

        row-gpios
            = <&gpio0 2  GPIO_ACTIVE_HIGH> /* Row0: D0 (PA02) */
            , <&gpio0 3  GPIO_ACTIVE_HIGH> /* Row1: D1 (PA04) */
            , <&gpio0 28 GPIO_ACTIVE_HIGH> /* Row2: D2 (PA10) */
            , <&gpio0 29 GPIO_ACTIVE_HIGH> /* Row3: D3 (PA11) */
            ;
    };
};

&uicr {
    nfct-pins-as-gpios;
};

/ {
    // 右手をペリフェラル（スレーブ）にする設定
    chosen {
        zmk,matrix_transform = &default_transform;
    };
};

&default_transform {
    col-offset = <6>; // 右手は6列目からスタート
};