#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <12>;

        map = <
                                                            RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
                                                            RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
                                                            RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                                                            RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        // 回路図 Polaris_R.kicad_sch の U1 ラベルより完全に一致するGPIOを抽出
        col-gpios
            = <&gpio0 5  GPIO_ACTIVE_HIGH> // Col0 (PA05_A5_D5_SCL)
            , <&gpio0 30 GPIO_ACTIVE_HIGH> // Col1 (PA30_SWDCLK) ※ココが修正点です
            , <&gpio0 31 GPIO_ACTIVE_HIGH> // Col2 (PA31_SWDIO) ※ココが修正点です
            , <&gpio0 29 GPIO_ACTIVE_HIGH> // Col3 (PA29_A3_D3)  ※ココが修正点です
            , <&gpio0 28 GPIO_ACTIVE_HIGH> // Col4 (PA28_A2_D2)  ※ココが修正点です
            , <&gpio0 3  GPIO_ACTIVE_HIGH> // Col5 (PA03_A1_D1)  ※ココが修正点です
            ;

        row-gpios
            = <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row0 (PA02_A0_D0)
            , <&gpio0 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row1 (PA04_A4_D4_SDA) ※ココが修正点です
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row2 (PA10_A10_D10_MISO) ※ココが修正点です
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row3 (PA11_RESET) ※ココが修正点です
            ;
    };
};

&uicr {
    nfct-pins-as-gpios;
};