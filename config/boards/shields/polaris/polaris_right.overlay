#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    /*
     * 左右共通の4行12列matrix transform
     */
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";

        rows = <4>;
        columns = <12>;

        map = <
            /* Row 0 */
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)

            /* Row 1 */
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
            RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)

            /* Row 2 */
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
            RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)

            /* Row 3 */
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
            RC(3,6) RC(3,7) RC(3,9) RC(3,10)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";

        /*
         * 左側と同じダイオード方向
         */
        diode-direction = "row2col";

        /*
         * Row
         *
         * Row0 -> D0
         * Row1 -> D1
         * Row2 -> D2
         * Row3 -> D3
         */
        row-gpios
            = <&xiao_d 0 GPIO_ACTIVE_HIGH>
            , <&xiao_d 1 GPIO_ACTIVE_HIGH>
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>
            ;

        /*
         * Col
         *
         * Col0 -> D4
         * Col1 -> D5
         * Col2 -> D6
         * Col3 -> D9
         * Col4 -> D7
         * Col5 -> NFC2 / P0.10
         *
         * NFC1 / P0.09 はトラックボールのMOTIONなので使用しない。
         */
        col-gpios
            = <&xiao_d 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 10  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};

/*
 * NFC1/NFC2をGPIOとして使用可能にする。
 *
 * NFC1 = P0.09 → トラックボール MOTION
 * NFC2 = P0.10 → キーボード Col5
 */
&uicr {
    nfct-pins-as-gpios;
};

/*
 * 右側は左側の6列の後ろに配置する。
 *
 * 左：0～5
 * 右：6～11
 */
&default_transform {
    col-offset = <6>;
};