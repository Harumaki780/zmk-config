#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* Row 0 */
                &kp Y       &kp U       &kp I       &kp O       &kp P       &trans

                /* Row 1 */
                &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp COLON

                /* Row 2 */
                &kp N       &kp M       &kp COMMA   &kp DOT     &kp SLASH   &kp BSLH

                /* Row 3 */
                &kp BSPC    &kp ENTER    &trans      &kp LEFT    &kp RIGHT   &trans
            >;
        };
    };
};